# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Every variable below is read by src/lib/config/env.ts and validated with zod
# at startup. Variables marked REQUIRED have no default - the process exits if
# they are missing.

# ---- Server ----
PORT=3000

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password            # REQUIRED
DB_NAME=food_ordering                   # REQUIRED
DB_POOL_MAX=10

# Resolved relative to the core-service root. Keep these values unless you
# move the migrations folder - knexfile.ts feeds them straight to Knex.
DB_MIGRATIONS_DIRECTORY=src/migrations   # REQUIRED
DB_MIGRATIONS_EXTENSION=ts               # REQUIRED

# ---- JWT ----
# Use long random strings, different for each secret. For example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=replace_with_a_long_random_string    # REQUIRED
REFRESH_SECRET=replace_with_a_different_one        # REQUIRED
ACCESS_EXPIRATION=15m                              # REQUIRED
REFRESH_EXPIRATION=7d                              # REQUIRED

# ---- CORS ----
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3001

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                          # optional, leave empty for local Redis

# ---- Mailjet (transactional email: password reset) ----
MAILJET_API_KEY=your_mailjet_api_key     # REQUIRED
MAILJET_SECRET_KEY=your_mailjet_secret   # REQUIRED
MAILJET_FROM_EMAIL=no-reply@example.com  # REQUIRED
MAILJET_FROM_NAME=Food Ordering App      # REQUIRED

# ---- RabbitMQ (outbox worker publishes core events here) ----
RABBIT_URL=amqp://localhost:5672
RABBIT_EXCHANGE=core.events
RABBIT_BATCH_SIZE=50

# ---- Internal API ----
# Shared key order-service sends in x-api-key when calling /api/internal/*.
# Must equal order-service's CORE_INTERNAL_API_KEY.
ORDER_SERVICE_API_KEY=replace_with_a_long_random_string   # REQUIRED

# ---- AWS S3 (media uploads - app/media, pkg/storage/s3.ts) ----
AWS_REGION=eu-north-1
# Bucket name or full ARN, e.g. arn:aws:s3:::dodsquickbites3 - env.ts accepts
# either and strips the arn prefix. Uploads land under restaurant/<id>/.
S3_BUCKET=arn:aws:s3:::your_bucket            # REQUIRED
AWS_ACCESS_KEY_ID=your_access_key_id          # REQUIRED
AWS_SECRET_ACCESS_KEY=your_secret_access_key  # REQUIRED
# Lifetime of presigned upload/download urls, in seconds (max 604800)
S3_SIGNED_URL_EXPIRES_IN=900
# Largest accepted upload, in bytes (5 MiB)
MEDIA_MAX_UPLOAD_BYTES=5242880
