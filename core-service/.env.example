# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Every variable below is read by src/lib/config/env.ts and validated with zod
# at startup. Variables marked REQUIRED have no default - the process exits if
# they are missing.

# ---- Server ----
PORT=3000

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password            # REQUIRED
DB_NAME=food_ordering                   # REQUIRED
DB_POOL_MAX=10

# Resolved relative to the core-service root. Keep these values unless you
# move the migrations folder - knexfile.ts feeds them straight to Knex.
DB_MIGRATIONS_DIRECTORY=src/migrations   # REQUIRED
DB_MIGRATIONS_EXTENSION=ts               # REQUIRED

# ---- JWT ----
# Use long random strings, different for each secret. For example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=replace_with_a_long_random_string    # REQUIRED
REFRESH_SECRET=replace_with_a_different_one        # REQUIRED
ACCESS_EXPIRATION=15m                              # REQUIRED
REFRESH_EXPIRATION=7d                              # REQUIRED

# ---- CORS ----
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3001

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                          # optional, leave empty for local Redis

# ---- Mailjet (transactional email: password reset) ----
MAILJET_API_KEY=your_mailjet_api_key     # REQUIRED
MAILJET_SECRET_KEY=your_mailjet_secret   # REQUIRED
MAILJET_FROM_EMAIL=no-reply@example.com  # REQUIRED
MAILJET_FROM_NAME=Food Ordering App      # REQUIRED
