{
  "name": "order-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "knex": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.12",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.1",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "tsx@4.23.12": true,
    "class-transformer@0.5.1": true,
    "class-validator@0.15.1": true,
    "tsyringe@4.10.0": true,
    "@types/cors@2.8.19": true,
    "cors@2.8.6": true,
    "@types/helmet@0.0.48": true,
    "helmet@8.3.0": true,
    "@types/ioredis@4.28.10": true,
    "ioredis@6.0.0": true,
    "esbuild@0.28.2": true
  }
