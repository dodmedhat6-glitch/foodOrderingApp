PORT=3001

# Comma-separated list of shard/region codes. Order determines each region's
# numeric Snowflake id (index in this list) - see src/lib/config/env.ts.
REGIONS=EG,SA

DB_POOL_MAX=10
DB_MIGRATIONS_DIRECTORY=src/migrations
DB_MIGRATIONS_EXTENSION=ts

# One block per code listed in REGIONS. "hot" is the live shard, "*_ARCHIVE_NAME"
# is the cold per-country archive database (01-system-design.md §7.4/§11).
DB_EG_HOST=localhost
DB_EG_PORT=5432
DB_EG_USER=postgres
DB_EG_PASSWORD=changeme
DB_EG_NAME=order_service_eg
DB_EG_ARCHIVE_NAME=order_service_eg_archive

DB_SA_HOST=localhost
DB_SA_PORT=5432
DB_SA_USER=postgres
DB_SA_PASSWORD=changeme
DB_SA_NAME=order_service_sa
DB_SA_ARCHIVE_NAME=order_service_sa_archive

ACCESS_SECRET=change_me_access
REFRESH_SECRET=change_me_refresh
ACCESS_EXPIRATION=15m
REFRESH_EXPIRATION=7d

CORS_ORIGIN=http://localhost:3001

REDIS_HOST=localhost
REDIS_PORT=6379

# Must match core-service's RABBIT_EXCHANGE - it's the topic exchange
# core-service's outbox drain worker publishes cache-invalidation events to.
RABBIT_URL=amqp://localhost:5672
RABBIT_EXCHANGE=core.events
RABBIT_QUEUE=order-service.cache-invalidation
RABBIT_BINDING_KEY=core.*.invalidated

# core-service's base URL and the shared secret sent as the X-Api-Key header
# on every call to its /api/internal/* endpoints - must match
# ORDER_SERVICE_API_KEY in core-service's own .env.
# Origin only - no trailing "/api". Request paths already include it,
# e.g. "/api/internal/branches/123".
CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_SERVICE_API_KEY=change_me_shared_with_core_service
