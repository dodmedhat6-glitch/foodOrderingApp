PORT=4000
NODE_ENV=development

# ---- auth (secrets MUST match core-service) ----
ACCESS_SECRET=change-me
REFRESH_SECRET=change-me
ACCESS_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

# ---- http ----
CORS_ORIGINS=http://localhost:3000

# ---- sharding ----
# Lowercase country codes. Region codes are case-sensitive: they are the suffix
# of the DB_* / ARCHIVE_DB_* keys below, the Redis key prefix, and the X-Region
# header value. (process.env lookups happen to be case-insensitive on Windows
# only — a mismatch here boots locally and fails on Linux.)
REGIONS=eg,sa

DB_POOL_MAX=10
DB_MIGRATION_DIRECTORY=src/migrations
DB_MIGRATION_EXTENSION=ts

# ---- region: eg (hot) ----
DB_eg_HOST=localhost
DB_eg_PORT=5432
DB_eg_USERNAME=postgres
DB_eg_PASSWORD=
DB_eg_NAME=order_service_eg

# ---- region: eg (archive — consumed from Phase 7) ----
ARCHIVE_DB_eg_HOST=localhost
ARCHIVE_DB_eg_PORT=5432
ARCHIVE_DB_eg_USERNAME=postgres
ARCHIVE_DB_eg_PASSWORD=
ARCHIVE_DB_eg_NAME=order_service_eg_archive

# ---- region: sa (hot) ----
DB_sa_HOST=localhost
DB_sa_PORT=5432
DB_sa_USERNAME=postgres
DB_sa_PASSWORD=
DB_sa_NAME=order_service_sa

# ---- region: sa (archive — consumed from Phase 7) ----
ARCHIVE_DB_sa_HOST=localhost
ARCHIVE_DB_sa_PORT=5432
ARCHIVE_DB_sa_USERNAME=postgres
ARCHIVE_DB_sa_PASSWORD=
ARCHIVE_DB_sa_NAME=order_service_sa_archive

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- rabbitmq (inbound core events) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=order-service.core-events
# NOTE: these do NOT match what core-service publishes today
# (`core.<entity>.invalidated`). See docs/implementation-plan.md Phase 1 step 12.
RABBITMQ_CORE_EVENTS_BINDINGS="core.#"
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=order-service.core-events.dlq
RABBITMQ_PREFETCH=32

# ---- core-service integration ----
CORE_SERVICE_BASE_URL=http://localhost:3000
# Must equal ORDER_SERVICE_API_KEY in core-service/.env — core stores only its
# hash, in the api_keys table seeded by migration 20260927100300.
CORE_INTERNAL_API_KEY=change-me

# ---- websocket ----
WS_HEARTBEAT_SEC=30

# ---- orders ----
# Platform service fee in basis points of the subtotal (0 = disabled).
PLATFORM_SERVICE_FEE_BPS=0
# Seconds after placement during which a customer may still cancel.
CUSTOMER_CANCELLATION_WINDOW_SEC=60
# TTL for the cached GET /api/restaurant/orders page.
RESTAURANT_ORDERS_CACHE_TTL_SEC=10
