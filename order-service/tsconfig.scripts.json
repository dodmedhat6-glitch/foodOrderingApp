{
  // `tsconfig.json` has rootDir/outDir pinned to src/ so the build emits a clean
  // dist/. Operational scripts under scripts/ are run through tsx and never
  // emitted, so they need their own noEmit config to be typechecked at all.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts", "src"]
}
