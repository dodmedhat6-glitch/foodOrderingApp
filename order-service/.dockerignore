# The build context. `COPY . .` in the builder stage would otherwise pull the
# whole directory in, so anything not needed to run `tsc` is excluded here.
# Most important: .env must never enter the context — it would be readable in
# the builder image layer even though the runtime stage only copies dist/.

.env
.env.*
*.log

node_modules
dist

.git
.gitignore
.idea
.vscode
.claude
.mcp.json

# local experimentation scripts, never part of a build
play/

docs
*.md

Dockerfile
.dockerignore
docker-compose.yml
