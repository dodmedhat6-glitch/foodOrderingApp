# Copy to .env and fill in the REQUIRED values.
# Every variable is declared in lib/config.py and validated at boot; a
# missing REQUIRED value stops the process before anything connects.

# ---- http ----
PORT=4100
LOG_LEVEL=INFO

# ---- auth (MUST match core-service and order-service) ----
# HS256: use at least 32 bytes, or PyJWT warns on every verify.
ACCESS_SECRET=change-me                       # REQUIRED

# ---- mongo ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=quickbite_analytics

# ---- rabbitmq (inbound order events) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Declared by order-service's worker; asserted (idempotently) here too.
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ORDER_EVENTS_QUEUE=analytics-service.order-events
# Comma-separated. `#` not `*`: a later `order.item.refunded` must still match.
RABBITMQ_ORDER_EVENTS_BINDINGS=order.#,payment.#
# Our own DLX, not a shared one: a DLQ bound `#` on a shared DLX would also
# collect every other consumer's dead letters.
RABBITMQ_ORDER_EVENTS_DLX=analytics-service.order-events.dlx
RABBITMQ_ORDER_EVENTS_DLQ=analytics-service.order-events.dlq
RABBITMQ_PREFETCH=32

# How long a processed eventId is remembered (Mongo TTL index on event_ids).
EVENT_DEDUPE_TTL_DAYS=7

# ---- core-service (RBAC lookups) ----
CORE_SERVICE_BASE_URL=http://localhost:3000    # REQUIRED (play/mock_core.py listens on 3999)
CORE_INTERNAL_API_KEY=change-me                # REQUIRED
CORE_TIMEOUT_MS=3000
# Role -> permissions are cached in-process for this long.
RBAC_CACHE_TTL_SEC=300

# ---- analytics ----
# Widest from..to window a read endpoint accepts, inclusive.
ANALYTICS_MAX_RANGE_DAYS=366
